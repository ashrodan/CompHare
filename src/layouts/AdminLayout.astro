---
import Layout from './Layout.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
---

<Layout title={`${title} - Admin - CompHare`}>
  <div class="min-h-screen bg-gradient-to-br from-neutral-dark via-neutral-darker to-black">
    <!-- Admin Header -->
    <header class="bg-neutral-dark border-b border-primary/20">
      <div class="container mx-auto px-4">
        <div class="flex items-center justify-between h-16">
          <!-- Logo -->
          <div class="flex items-center space-x-4">
            <a href="/admin" class="text-2xl font-bold">
              <span class="text-primary">Comp</span><span class="text-accent">Hare</span>
            </a>
            <span class="text-neutral-light text-sm px-3 py-1 bg-primary/10 rounded-full border border-primary/30">
              Admin
            </span>
          </div>

          <!-- Navigation -->
          <nav class="hidden md:flex items-center space-x-6">
            <a
              href="/admin"
              class={`text-sm transition-colors ${currentPath === '/admin' ? 'text-primary font-semibold' : 'text-neutral-light hover:text-primary'}`}
            >
              Dashboard
            </a>
            <a
              href="/admin/gas-providers"
              class={`text-sm transition-colors ${currentPath.startsWith('/admin/gas-providers') ? 'text-primary font-semibold' : 'text-neutral-light hover:text-primary'}`}
            >
              Gas Providers
            </a>
            <a
              href="/admin/olive-oil"
              class={`text-sm transition-colors ${currentPath.startsWith('/admin/olive-oil') ? 'text-primary font-semibold' : 'text-neutral-light hover:text-primary'}`}
            >
              Olive Oil
            </a>
            <span class="text-neutral-light">|</span>
            <a
              href="/"
              class="text-sm text-neutral-light hover:text-accent transition-colors"
              target="_blank"
            >
              View Site
            </a>
            <a
              href="/admin/logout"
              class="text-sm text-red-400 hover:text-red-300 transition-colors"
            >
              Logout
            </a>
          </nav>

          <!-- Mobile Menu Button -->
          <button
            id="mobile-menu-button"
            class="md:hidden text-neutral-light hover:text-primary transition-colors"
            aria-label="Toggle menu"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden md:hidden bg-neutral-dark border-b border-primary/20">
      <div class="container mx-auto px-4 py-4 space-y-3">
        <a href="/admin" class="block text-sm text-neutral-light hover:text-primary transition-colors">
          Dashboard
        </a>
        <a href="/admin/gas-providers" class="block text-sm text-neutral-light hover:text-primary transition-colors">
          Gas Providers
        </a>
        <a href="/admin/olive-oil" class="block text-sm text-neutral-light hover:text-primary transition-colors">
          Olive Oil
        </a>
        <hr class="border-primary/20" />
        <a href="/" class="block text-sm text-neutral-light hover:text-accent transition-colors" target="_blank">
          View Site
        </a>
        <a href="/admin/logout" class="block text-sm text-red-400 hover:text-red-300 transition-colors">
          Logout
        </a>
      </div>
    </div>

    <!-- Main Content -->
    <main class="container mx-auto px-4 py-8">
      <slot />
    </main>
  </div>
</Layout>

<script>
  // Mobile menu toggle
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  menuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>
