---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { requireAuth } from '../../../utils/auth';
import { prisma } from '../../../lib/db';

const authRedirect = requireAuth(Astro.cookies);
if (authRedirect) return authRedirect;

const providers = await prisma.oOVOProvider.findMany({
  include: {
    volumeOptions: {
      orderBy: { volume: 'asc' }
    }
  },
  orderBy: { name: 'asc' }
});
---

<AdminLayout title="Olive Oil Providers">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-3xl font-bold text-white mb-2">Olive Oil Providers</h1>
      <p class="text-neutral-light">Manage olive oil comparisons</p>
    </div>
    <a
      href="/admin/olive-oil/new"
      class="bg-primary hover:bg-accent text-white font-bold py-2 px-6 rounded-lg transition-all duration-300 shadow-neon inline-flex items-center gap-2"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
      </svg>
      Add Provider
    </a>
  </div>

  {providers.length === 0 ? (
    <div class="bg-neutral-dark border border-primary/20 rounded-lg p-12 text-center shadow-neon">
      <h3 class="text-xl font-semibold text-white mb-2">No Providers Yet</h3>
      <p class="text-neutral-light mb-6">Get started by adding your first olive oil provider</p>
      <a href="/admin/olive-oil/new" class="inline-block bg-primary hover:bg-accent text-white font-bold py-2 px-6 rounded-lg transition-all">
        Add Your First Provider
      </a>
    </div>
  ) : (
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      {providers.map((provider) => (
        <div class="bg-neutral-dark border border-primary/20 rounded-lg p-6 shadow-neon hover:border-primary transition-all">
          <div class="flex items-start justify-between mb-4">
            <div class="flex-1">
              <h3 class="text-xl font-bold text-white mb-2">{provider.name}</h3>
              <div class="flex flex-wrap gap-2 text-sm mb-3">
                <span class="bg-primary/20 text-primary px-2 py-1 rounded">{provider.location}</span>
                <span class="bg-accent/20 text-accent px-2 py-1 rounded">{provider.stockStatus}</span>
              </div>
              <p class="text-neutral-light text-sm mb-3">{provider.description}</p>
              <p class="text-sm text-neutral-light">Shipping: <span class="text-white font-semibold">${provider.shipping.toFixed(2)}</span></p>
            </div>
            <div class="flex gap-2 ml-4">
              <a href={`/admin/olive-oil/edit/${provider.id}`} class="p-2 bg-primary/20 hover:bg-primary/30 text-primary rounded-lg transition-colors" title="Edit">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                </svg>
              </a>
              <button class="p-2 bg-red-500/20 hover:bg-red-500/30 text-red-400 rounded-lg transition-colors delete-btn" data-id={provider.id} data-name={provider.name} title="Delete">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
              </button>
            </div>
          </div>
          <div class="border-t border-primary/20 pt-4">
            <h4 class="text-sm font-semibold text-white mb-2">Volume Options ({provider.volumeOptions.length})</h4>
            <div class="flex flex-wrap gap-2">
              {provider.volumeOptions.map((option) => (
                <div class="bg-neutral-darker px-3 py-1 rounded text-sm">
                  <span class="text-neutral-light">{option.volume}L:</span>
                  <span class="text-white font-semibold ml-1">${option.price.toFixed(2)}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  )}
</AdminLayout>

<script>
  document.querySelectorAll('.delete-btn').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const id = target.dataset.id;
      const name = target.dataset.name;

      if (!confirm(`Are you sure you want to delete "${name}"?`)) return;

      try {
        const response = await fetch(`/api/admin/olive-oil/${id}`, { method: 'DELETE' });
        if (response.ok) {
          window.location.reload();
        } else {
          alert('Failed to delete provider.');
        }
      } catch (error) {
        console.error('Delete error:', error);
        alert('An error occurred.');
      }
    });
  });
</script>

<style>
  .shadow-neon { box-shadow: 0 0 20px rgba(16, 185, 129, 0.1); }
</style>
