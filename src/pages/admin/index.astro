---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { requireAuth } from '../../utils/auth';
import { prisma } from '../../lib/db';

// Require authentication
const authRedirect = requireAuth(Astro.cookies);
if (authRedirect) return authRedirect;

// Fetch statistics
const gasProvidersCount = await prisma.gasProvider.count();
const oovoProvidersCount = await prisma.oOVOProvider.count();
const volumeOptionsCount = await prisma.oOVOVolumeOption.count();
---

<AdminLayout title="Dashboard">
  <!-- Page Header -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-white mb-2">Admin Dashboard</h1>
    <p class="text-neutral-light">Manage your comparison data</p>
  </div>

  <!-- Statistics Cards -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <!-- Gas Providers Card -->
    <div class="bg-neutral-dark border border-primary/20 rounded-lg p-6 shadow-neon">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-white">Gas Providers</h3>
        <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.879 16.121A3 3 0 1012.015 11L11 14H9c0 .768.293 1.536.879 2.121z"></path>
        </svg>
      </div>
      <p class="text-4xl font-bold text-primary mb-2">{gasProvidersCount}</p>
      <a href="/admin/gas-providers" class="text-sm text-accent hover:underline">
        Manage Providers →
      </a>
    </div>

    <!-- Olive Oil Providers Card -->
    <div class="bg-neutral-dark border border-primary/20 rounded-lg p-6 shadow-neon">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-white">Olive Oil Providers</h3>
        <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
        </svg>
      </div>
      <p class="text-4xl font-bold text-primary mb-2">{oovoProvidersCount}</p>
      <a href="/admin/olive-oil" class="text-sm text-accent hover:underline">
        Manage Providers →
      </a>
    </div>

    <!-- Volume Options Card -->
    <div class="bg-neutral-dark border border-primary/20 rounded-lg p-6 shadow-neon">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-white">Volume Options</h3>
        <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
        </svg>
      </div>
      <p class="text-4xl font-bold text-primary mb-2">{volumeOptionsCount}</p>
      <p class="text-sm text-neutral-light">Total pricing options</p>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="bg-neutral-dark border border-primary/20 rounded-lg p-6 shadow-neon">
    <h2 class="text-xl font-bold text-white mb-4">Quick Actions</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <a
        href="/admin/gas-providers/new"
        class="flex items-center justify-between p-4 bg-neutral-darker border border-primary/20 rounded-lg hover:border-primary transition-all group"
      >
        <div>
          <h3 class="text-white font-semibold mb-1">Add Gas Provider</h3>
          <p class="text-sm text-neutral-light">Create a new gas rate comparison</p>
        </div>
        <svg class="w-6 h-6 text-primary group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
      </a>

      <a
        href="/admin/olive-oil/new"
        class="flex items-center justify-between p-4 bg-neutral-darker border border-primary/20 rounded-lg hover:border-primary transition-all group"
      >
        <div>
          <h3 class="text-white font-semibold mb-1">Add Olive Oil Provider</h3>
          <p class="text-sm text-neutral-light">Create a new olive oil listing</p>
        </div>
        <svg class="w-6 h-6 text-primary group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
      </a>

      <a
        href="/"
        target="_blank"
        class="flex items-center justify-between p-4 bg-neutral-darker border border-primary/20 rounded-lg hover:border-accent transition-all group"
      >
        <div>
          <h3 class="text-white font-semibold mb-1">View Public Site</h3>
          <p class="text-sm text-neutral-light">See how your data looks to users</p>
        </div>
        <svg class="w-6 h-6 text-accent group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
        </svg>
      </a>

      <a
        href="/admin/logout"
        class="flex items-center justify-between p-4 bg-neutral-darker border border-red-500/20 rounded-lg hover:border-red-500 transition-all group"
      >
        <div>
          <h3 class="text-white font-semibold mb-1">Logout</h3>
          <p class="text-sm text-neutral-light">End your admin session</p>
        </div>
        <svg class="w-6 h-6 text-red-400 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
        </svg>
      </a>
    </div>
  </div>
</AdminLayout>

<style>
  .shadow-neon {
    box-shadow: 0 0 20px rgba(16, 185, 129, 0.1);
  }
</style>
