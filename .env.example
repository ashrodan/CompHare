# Neon PostgreSQL Database Connection
# Get your connection string from: https://console.neon.tech
# Format: postgresql://[user]:[password]@[host]/[database]?sslmode=require

DATABASE_URL="postgresql://username:password@ep-example-123456.us-east-2.aws.neon.tech/compHare?sslmode=require"

# Optional: Prisma connection pooling for serverless (recommended for production)
# DIRECT_URL="postgresql://username:password@ep-example-123456.us-east-2.aws.neon.tech/compHare?sslmode=require"

# Admin Dashboard Credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-password"
SESSION_SECRET="change-this-secret-key-in-production"
